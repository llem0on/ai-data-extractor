      "description": "Document title",
      "type": "string",
      "labels": ["judul", "perihal", "nama dokumen", "title", "document\\s*(?:name|title)"]
    },
    {
      "name": "department",
      "description": "Department, division or unit that owns the document",
      "type": "string",
      "labels": ["departemen", "department", "divisi", "division", "unit kerja"]
    },
    {
